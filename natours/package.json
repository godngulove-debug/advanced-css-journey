{
  "name": "naturess",
  "version": "1.0.0",
  "description": "Landing page for natours",
  "main": "index.js",
  "scripts": {
    "watch:sass": "sass sass/main.scss css/style.css -w",
    "devserver": "liveserver",
    "start": "npm-run-all --parallel devserver watch:sass",
    "compile:sass": "sass sass/main.scss css/style.comp.css",
    "concat:css": "concat -o css/style.concat.css css/icon-fonts.css css/style.comp.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.concat.css -o css/style.prefix.css",
    "compress:css": "sass css/style.prefix.css css/style.css --style=compressed",
    "build:css": "npm-run-all compile:sass concat:css prefix:css compress:css",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godngulove-debug/advanced-css-journey.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/godngulove-debug/advanced-css-journey/issues"
  },
  "homepage": "https://github.com/godngulove-debug/advanced-css-journey#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "concat": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^11.0.1",
    "sass": "^1.93.2",
    "vite": "^7.2.2"
  }
}
